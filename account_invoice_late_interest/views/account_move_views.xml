<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_late_interest" model="ir.ui.view">
        <field name="name">account.move.form.late.interest</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="late_interest_applicable" invisible="1"/>
            </xpath>
            <xpath expr="/form/sheet" position="before">
                <div class="alert alert-danger mb-0" role="alert"
                     attrs="{'invisible': ['|', ('late_interest_applicable', '=', False), ('late_interest_fully_paid', '=', True)]}">
                    Factura vencida: <field name="late_interest_days" class="fw-bold"/> días de demora.
                    Intereses de demora devengados: <field name="late_interest_amount" class="fw-bold"/>
                    + indemnización por costes de cobro: <field name="late_interest_compensation"/>.
                </div>
                <div class="alert alert-warning mb-0" role="alert"
                     attrs="{'invisible': ['|', ('late_interest_applicable', '=', False), ('late_interest_fully_paid', '=', False)]}">
                    Factura cobrada con <field name="late_interest_days" class="fw-bold"/> días de demora.
                    Intereses de demora reclamables: <field name="late_interest_amount" class="fw-bold"/>
                    + indemnización por costes de cobro: <field name="late_interest_compensation"/>.
                </div>
            </xpath>
            <xpath expr="//page[@id='other_tab']" position="after">
                <page id="late_interest_tab" string="Intereses de demora" name="late_interest"
                      attrs="{'invisible': ['|', ('move_type', '!=', 'out_invoice'), ('late_interest_enabled', '=', False)]}">
                    <field name="late_interest_enabled" invisible="1"/>
                    <group>
                        <group string="Fechas">
                            <field name="late_interest_due_date"/>
                            <field name="late_interest_due_date_manual"/>
                            <field name="late_interest_registration_date"/>
                            <field name="late_interest_recognition_date"/>
                            <field name="late_interest_end_date"
                                   attrs="{'invisible': [('late_interest_applicable', '=', False)]}"/>
                            <field name="late_interest_fully_paid"
                                   attrs="{'invisible': [('late_interest_applicable', '=', False)]}"/>
                        </group>
                        <group string="Liquidación"
                               attrs="{'invisible': [('late_interest_applicable', '=', False)]}">
                            <field name="late_interest_days"/>
                            <field name="late_interest_base"/>
                            <field name="late_interest_amount"/>
                            <field name="late_interest_compensation"/>
                            <field name="late_interest_total" class="fw-bold"/>
                        </group>
                    </group>
                    <field name="late_interest_detail_html" nolabel="1" readonly="1"
                           attrs="{'invisible': [('late_interest_applicable', '=', False)]}"/>
                    <p class="text-muted" attrs="{'invisible': [('late_interest_applicable', '=', True)]}">
                        Esta factura no ha devengado intereses de demora.
                    </p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
