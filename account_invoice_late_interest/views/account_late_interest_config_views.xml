<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_late_interest_config_form" model="ir.ui.view">
        <field name="name">account.late.interest.config.form</field>
        <field name="model">account.late.interest.config</field>
        <field name="arch" type="xml">
            <form string="Intereses de demora">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <group>
                        <group string="Aplicar a">
                            <field name="partner_category_ids" widget="many2many_tags"
                                   options="{'color_field': 'color', 'no_create_edit': True}"
                                   placeholder="Etiquetas de contacto"/>
                        </group>
                        <group string="Importes">
                            <field name="rate"/>
                            <field name="compensation"/>
                        </group>
                    </group>
                    <group string="Reclamante">
                        <group>
                            <field name="representative_name" placeholder="D. Nombre Apellido Apellido"/>
                            <field name="representative_vat"/>
                            <field name="representation_document"/>
                        </group>
                        <group>
                            <field name="notification_address"/>
                            <field name="city"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_late_interest_config" model="ir.actions.server">
        <field name="name">Intereses de demora</field>
        <field name="model_id" ref="model_account_late_interest_config"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <menuitem id="menu_account_late_interest_config"
              name="Intereses de demora"
              parent="account.account_invoicing_menu"
              action="action_account_late_interest_config"
              groups="account.group_account_manager"
              sequence="90"/>
</odoo>
